set timeout 15
spawn npx eas credentials --platform ios
expect {
  timeout { puts "TIMED OUT"; exit 1 }
  "Which build profile do you want to configure?" {
    send "\x1B\x5BB\x1B\x5BB\r"
    exp_continue
  }
  "What do you want to do?" {
    puts "\nMENU REACHED: $expect_out(buffer)"
    exit 0
  }
  "Press any key" { send "\n"; exp_continue }
  eof { puts "EOF"; exit 0 }
}
