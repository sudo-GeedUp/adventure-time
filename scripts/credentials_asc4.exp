set timeout 30
spawn npx eas credentials --platform ios
expect {
  "Which build profile do you want to configure?" {
    send "\r"
    exp_continue
  }
  "Do you want to log in to your Apple account?" {
    send "n\r"
    exp_continue
  }
  "What do you want to do?" {
    sleep 2
    # 2 down arrows to "App Store Connect: Manage your API Key", then enter
    send "\x1b\x5BB"
    sleep 0.5
    send "\x1b\x5BB"
    sleep 0.5
    send "\r"
    exp_continue
  }
  "App Store Connect" {
    puts "\n--- API KEY DETAIL ---"
    puts $expect_out(buffer)
    exit 0
  }
  timeout { puts "TIMED OUT"; exit 1 }
  eof { puts "EOF"; exit 0 }
}
