set timeout 25
spawn npx eas credentials --platform ios
expect {
  "Which build profile do you want to configure?" {
    send "\r"
    exp_continue
  }
  "Do you want to log in to your Apple account?" {
    send "n\r"
    exp_continue
  }
  "What do you want to do?" {
    # wait for menu to render
    sleep 1
    # move down to "App Store Connect: Manage your API Key" (3rd item)
    send "\x1b\x5BB"
    sleep 0.5
    send "\x1b\x5BB"
    sleep 0.5
    send "\r"
    exp_continue
  }
  "App Store Connect API Key" {
    puts "\n--- API KEY SUBMENU ---"
    puts $expect_out(buffer)
    exit 0
  }
  timeout { puts "TIMED OUT"; exit 1 }
  eof { puts "EOF"; exit 0 }
}
