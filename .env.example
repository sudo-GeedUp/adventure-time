# Firebase Configuration
# Get these from: https://console.firebase.google.com
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Maps API Key
# Get this from: https://console.cloud.google.com
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Premium Raster Tile Providers (optional - used when user has premium subscription)
# Mapbox: https://account.mapbox.com/access-tokens
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
# MapTiler: https://cloud.maptiler.com/account/keys
EXPO_PUBLIC_MAPTILER_KEY=

# RevenueCat API Keys
# Get these from: https://app.revenuecat.com
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# OpenAI API Key (for AI features)
# Get this from: https://platform.openai.com/api-keys
EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here

# OpenWeather API Key (for weather features)
EXPO_PUBLIC_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google OAuth (for Google Sign-In)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Push Notifications
# iOS aps-environment entitlement mode: development or production
EXPO_PUBLIC_NOTIFICATIONS_MODE=production
